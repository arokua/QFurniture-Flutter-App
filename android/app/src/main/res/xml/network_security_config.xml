<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration
  ================================
  Only the QFurniture store domain is explicitly trusted for HTTPS.
  No cleartext (HTTP) traffic is allowed outside of localhost.
  This satisfies Android 9+ (API 28+) security requirements.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">qfurniture.com.au</domain>
    </domain-config>

    <!-- Allow cleartext on localhost only (for debug builds / dev server) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
